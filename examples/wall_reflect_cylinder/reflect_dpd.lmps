units           lj
atom_style      hybrid edpd bond
boundary        p f f

newton          on on
read_data       init_mdpd.dat

# Groups
group monomers  type 1
group solvent   type 2
group wall      type 3
group integrate union monomers solvent
group all       union integrate wall
group flow      union solvent wall

neighbor        2.0 bin
comm_modify     vel yes
comm_modify     cutoff 3.6

# Initial velocities
velocity integrate create 1.0 69

# Parameters
variable gamma equal 4.5

# Pair styles
pair_style dpd 1.0 1.0 373692
pair_coeff 1 1 25.0 ${gamma} 1.0 
pair_coeff 2 2 25.0 ${gamma} 1.0 
pair_coeff 3 3 0.0  0.0      1.0 
pair_coeff 1 2 20.0 ${gamma} 1.0
pair_coeff 1 3 9.01 ${gamma} 1.0
pair_coeff 2 3 9.01 ${gamma} 1.0

neigh_modify delay 0 every 4 check yes
neigh_modify exclude type 3 3

timestep 0.02

# Integrators and wall
fix 1 integrate mvv/dpd 0.65
fix 2 wall setforce 0.0 0.0 0.0
fix wall integrate wall/reflectcylinder 5.0 6.7 6.7

# Equilibration
run 1000

# Apply constant force to solvent for flow
fix 3 solvent addforce 0.1 0.0 0.0

# Output dump
dump dum all custom 500 dump.flow.dat id type mol xu yu zu vx vy vz

# Production run
run 20000

